# The Group of Joining Hands - Production Environment Configuration Template
# Copy this file to .env on your deployment server and configure real parameters.
# NEVER commit the actual .env file containing real secrets to version control.

# ==============================================================================
# 1. APPLICATION RUNTIME & NETWORK BINDING
# ==============================================================================
APP_ENV=production
HOST=0.0.0.0
PORT=8080

# ==============================================================================
# 2. CRYPTOGRAPHIC SECRETS & TOKENS
# ==============================================================================
# Generate a strong 64-char secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-character-secret-in-production
JWT_SECRET=change-this-to-a-random-64-character-jwt-secret-in-production

# ==============================================================================
# 3. CORS & ACCESS CONTROL (Comma-separated allowed domains)
# ==============================================================================
ALLOWED_ORIGINS=https://joining-hands.onrender.com,http://localhost:8080,http://127.0.0.1:8080

# ==============================================================================
# 4. DATABASE CONFIGURATION (MIGRATION READY)
# ==============================================================================
# Provider options: 'sqlite' (default) | 'postgresql'
DB_PROVIDER=sqlite

# SQLite Storage Paths (Default)
DB_FILE=database/database.db
BACKUP_DIR=database/backups

# Future PostgreSQL Connection URL (Leave blank for SQLite)
# DATABASE_URL=postgresql://user:password@hostname:5432/joining_hands_db

# ==============================================================================
# 5. PERSISTENT MEDIA STORAGE CONFIGURATION
# ==============================================================================
# Storage backend options: 'local' (default) | 's3' | 'cloud'
STORAGE_BACKEND=local

# ==============================================================================
# 6. INITIAL SUPER ADMINISTRATOR BOOTSTRAP (Optional)
# ==============================================================================
# ADMIN_EMAIL=admin@joininghands.org
# ADMIN_INITIAL_PASSWORD=YourStrongBootstrapPassword123!
